generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Users & Roles (Roles & Audit)
// ------------------------------------------------------
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  phone      String?
  name       String?
  password   String
  role       Role     @default(CASHIER)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  outlets    Outlet[] @relation("UserOutlets")
  orders     Order[]
  auditLogs  AuditLog[]
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  ACCOUNTANT
  CASHIER
  KITCHEN_STAFF
  STAFF
  CAPTAIN
  INVENTORY_MANAGER
  AUDITOR
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// Business Profile & Outlets (Settings)
// ------------------------------------------------------
model Outlet {
  id        String   @id @default(uuid())
  name      String
  location  String
  taxRate   Float    @default(5.0)
  users     User[]   @relation("UserOutlets")
  menus     Menu[]
  orders    Order[]
  inventory InventoryItem[]
  customers Customer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// Menu Management
// ------------------------------------------------------
model Menu {
  id          String   @id @default(uuid())
  name        String
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  categories  Category[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id])
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isAvailable Boolean  @default(true)
  variants    Variant[]
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Variant {
  id        String   @id @default(uuid())
  name      String   // e.g., "Half", "Full"
  price     Float
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// POS & Billing
// ------------------------------------------------------
model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  totalAmount Float
  taxAmount   Float    @default(0)
  discount    Float    @default(0)
  status      OrderStatus @default(PENDING)
  paymentMode PaymentMode
  paymentStatus PaymentStatus @default(UNPAID)
  type        OrderType @default(DINE_IN)
  tableNumber String?
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  AGGREGATOR
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  WALLET
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// Recipes & Inventory
// ------------------------------------------------------
model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String   // Vegetables, Meat, Dairy, etc.
  quantity    Float
  unit        String   // kg, L, pcs, etc.
  minStock    Float
  status      String   @default("In Stock")
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  recipeItems RecipeItem[]
  purchaseItems PurchaseItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecipeItem {
  id            String   @id @default(uuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  inventoryId   String
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  quantityUsed  Float    // Amount of inventory unit used for this recipe
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------
// Purchases & Vendors
// ------------------------------------------------------
model Vendor {
  id             String   @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  totalAmount Float
  status      POStatus @default(PENDING)
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  items       PurchaseItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum POStatus {
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryId     String
  inventoryItem   InventoryItem @relation(fields: [inventoryId], references: [id])
  quantity        Float
  price           Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------
// CRM & Customers
// ------------------------------------------------------
model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  email      String?
  visits     Int      @default(0)
  totalSpent Float    @default(0)
  loyaltyPts Int      @default(0)
  segment    String   @default("New")
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------
// Aggregator Inbox
// ------------------------------------------------------
model AggregatorOrder {
  id            String   @id @default(uuid())
  platform      String   // Zomato, Swiggy, Magicpin, ONDC
  aggregatorId  String   @unique
  customerName  String
  items         Json     // JSON representation of the order items
  totalAmount   Float
  status        String   @default("NEW") // NEW, ACCEPTED, REJECTED, DISPATCHED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}